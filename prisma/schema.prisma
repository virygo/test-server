generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  username      String         @unique
  password      String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  VendorProfile VendorProfile?
  Business      Business[]
  Booking       Booking[]
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  order         Int           @default(0)
  subcategories Subcategory[]
  filters       Filter[]      @relation("CategoryFilters")

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Business  Business[]
}

model Subcategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  order       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  bookingMode BookingMode @default(INSTANT)
  filters     Filter[]    @relation("SubcategoryFilters")

  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  Business   Business[]
  businesses BusinessSubcategory[]
}

model Filter {
  id            String         @id @default(cuid())
  key           String
  label         String
  type          FilterType
  options       FilterOption[]
  categoryId    String?
  category      Category?      @relation("CategoryFilters", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Subcategory?   @relation("SubcategoryFilters", fields: [subcategoryId], references: [id])

  @@unique([key, categoryId, subcategoryId], name: "key_scope")
}

model FilterOption {
  id       String @id @default(cuid())
  value    String
  label    String
  order    Int    @default(0)
  filterId String
  filter   Filter @relation(fields: [filterId], references: [id])

  @@unique([filterId, value], name: "filterId_value")
}

enum FilterType {
  SELECT
  MULTISELECT
  BOOLEAN
  RANGE
  TEXT
  DATE
  TIME
  DATETIME
  DATERANGE
  NUMBER
}

enum BookingMode {
  INSTANT
  REQUEST_TO_BOOK
}

/// ------- EXTRA ENUMS -------

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum Currency {
  EUR
  USD
  GBP
}

enum SlotStatus {
  AVAILABLE
  BLOCKED
}

/// ------- VENDOR PROFILE -------
/// 1-1 με User όταν ο ρόλος είναι VENDOR
model VendorProfile {
  id          String   @id @default(cuid())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String?
  taxId       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ------- BUSINESS (π.χ. Hotel/Bar/Spa κλπ) -------
model Business {
  id      String @id @default(cuid())
  ownerId Int
  owner   User   @relation(fields: [ownerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // many-to-many με Subcategory μέσω join table
  subcategories BusinessSubcategory[]

  name        String
  slug        String  @unique
  description String?
  email       String?
  phone       String?
  website     String?

  address1 String?
  address2 String?
  city     String?
  country  String?
  lat      Float?
  lng      Float?

  bookingMode BookingMode @default(INSTANT)

  services Service[]
  media    Media[]
  offers   Offer[]
  bookings Booking[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId String?

  @@index([ownerId])
  @@index([categoryId])
}

/// ------- MEDIA για κάρτες/φωτογραφίες -------
enum MediaKind {
  COVER
  GALLERY
  LOGO
  MENU
  THUMB
}

model Media {
  id         String     @id @default(cuid())
  businessId String?
  business   Business?  @relation(fields: [businessId], references: [id])
  url        String
  title      String?
  alt        String?
  kind       MediaKind? // π.χ. COVER, GALLERY, LOGO
  order      Int?       @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// ------- SERVICES (π.χ. Massage, Transfer, Hair, Spa treatment) -------
model Service {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // βασικά πεδία
  slug        String
  name        String
  description String?
  durationMin Int?
  price       Decimal? @db.Decimal(10, 2)
  currency    Currency @default(EUR)
  capacity    Int      @default(1)
  isActive    Boolean  @default(true)

  // σχέσεις
  slots    ServiceSlot[]
  bookings Booking[]

  // audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // μοναδικό ανά επιχείρηση
  @@unique([businessId, slug], name: "business_slug")
}

/// Διαθεσιμότητες service (time slots)
model ServiceSlot {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  startsAt DateTime
  endsAt   DateTime
  capacity Int        @default(1)
  booked   Int        @default(0)
  status   SlotStatus @default(AVAILABLE)
  Booking  Booking[]

  @@unique([serviceId, startsAt])
  @@index([startsAt])
}

/// ------- OFFERS (για την ενότητα Offers) -------
model Offer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  title    String
  subtitle String?
  startsAt DateTime?
  endsAt   DateTime?
  price    Decimal?  @db.Decimal(10, 2)
  currency Currency  @default(EUR)
  active   Boolean   @default(true)
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
}

/// ------- BOOKINGS (για δωμάτια ή services) -------
model Booking {
  id         String @id @default(cuid())
  customerId Int?
  customer   User?  @relation(fields: [customerId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  slotId String?
  slot   ServiceSlot? @relation(fields: [slotId], references: [id])

  status   BookingStatus @default(PENDING)
  payment  PaymentStatus @default(UNPAID)
  total    Decimal?      @db.Decimal(10, 2)
  currency Currency      @default(EUR)
  notes    String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([businessId, status])
}

/// ------- JOIN: Business <-> Subcategory (many-to-many) -------
model BusinessSubcategory {
  businessId    String
  subcategoryId String

  business    Business    @relation(fields: [businessId], references: [id])
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id])

  @@id([businessId, subcategoryId])
  @@index([subcategoryId])
}
